# ============ BARF - Variables de entorno ============
# Copia este fichero a `.env` y ajusta los valores.
# El `.env` real nunca se commitea (ver .gitignore).

# --- Navegador ---
# Ejecutar el navegador sin interfaz gráfica (true/false)
BROWSER_HEADLESS=false
# Timeout por defecto de las operaciones de Playwright (milisegundos)
BROWSER_TIMEOUT=30000

# --- Logging ---
# Nivel de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Recursos ---
# Ruta al fichero JSON con user agents para estudios de variación de navegador
USER_AGENT_LIST=./config/user_agents.json
